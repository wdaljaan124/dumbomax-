          flutter-version: '3.22.0'
          channel: 'stable'
      - run: flutter pub get
      - run: flutter build apk --release
      - uses: actions/upload-artifact@v4
        with:
          name: dumbomax-apk
          path: build/app/outputs/flutter-apk/app-release.apk
