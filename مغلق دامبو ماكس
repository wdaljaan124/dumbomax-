import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';
class DatabaseHelper {
  static final DatabaseHelper instance = DatabaseHelper._();
  static Database? _db;
  DatabaseHelper._();
  Future<Database> get database async { _db ??= await _initDB(); return _db!; }
  Future<Database> _initDB() async {
    String path = join(await getDatabasesPath(), 'dumbomax.db');
    return await openDatabase(path, version: 2, onCreate: _createTables);
  }
  Future<void> _createTables(Database db, int v) async {
    await db.execute('CREATE TABLE users(id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE, password TEXT, role TEXT DEFAULT "user")');
    await db.execute('CREATE TABLE items(id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE, barcode TEXT, name TEXT, buy_price REAL, sell_price REAL, buy_price_usd REAL DEFAULT 0, sell_price_usd REAL DEFAULT 0, wholesale_qty REAL DEFAULT 0, wholesale_price REAL DEFAULT 0, quantity REAL DEFAULT 0, min_qty REAL DEFAULT 0, warehouse_id INTEGER, category TEXT)');
    await db.execute('CREATE TABLE warehouses(id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, location TEXT, manager TEXT)');
    await db.execute('CREATE TABLE suppliers(id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, phone TEXT, address TEXT, balance REAL DEFAULT 0)');
    await db.execute('CREATE TABLE sales(id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_no TEXT, date TEXT, customer TEXT, total REAL, discount REAL, tax REAL, net REAL, payment_type TEXT DEFAULT "cash", paid REAL DEFAULT 0, type TEXT DEFAULT "sale")');
    await db.execute('CREATE TABLE sale_items(id INTEGER PRIMARY KEY AUTOINCREMENT, sale_id INTEGER, item_id INTEGER, qty REAL, price REAL, total REAL)');
    await db.execute('CREATE TABLE purchases(id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_no TEXT, date TEXT, supplier_id INTEGER, total REAL, net REAL, type TEXT DEFAULT "purchase")');
    await db.execute('CREATE TABLE purchase_items(id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_id INTEGER, item_id INTEGER, qty REAL, price REAL, total REAL)');
    await db.execute('CREATE TABLE proforma(id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_no TEXT, date TEXT, customer TEXT, total REAL, net REAL, status TEXT DEFAULT "pending")');
    await db.execute('CREATE TABLE journal(id INTEGER PRIMARY KEY AUTOINCREMENT, date TEXT, account TEXT, debit REAL, credit REAL, note TEXT)');
    await db.execute('CREATE TABLE accounts(id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, type TEXT, balance REAL DEFAULT 0)');
    await db.execute('CREATE TABLE employees(id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, phone TEXT, salary REAL DEFAULT 0, advance REAL DEFAULT 0)');
    await db.execute('CREATE TABLE expenses(id INTEGER PRIMARY KEY AUTOINCREMENT, date TEXT, title TEXT, amount REAL, type TEXT)');
    await db.execute('CREATE TABLE cheques(id INTEGER PRIMARY KEY AUTOINCREMENT, number TEXT, type TEXT, amount REAL, due_date TEXT, status TEXT DEFAULT "pending", customer TEXT)');
    await db.execute('CREATE TABLE payments(id INTEGER PRIMARY KEY AUTOINCREMENT, sale_id INTEGER, customer TEXT, amount REAL, date TEXT, note TEXT)');
  }
  Future<void> updateByUsd(double rate) async {
    final db = await database;
    await db.rawUpdate('UPDATE items SET sell_price = sell_price_usd * ?, buy_price = buy_price_usd * ?', [rate, rate]);
  }
  Future<void> updateByPercent(double percent, bool increase) async {
    final db = await database;
    double f = increase ? (1 + percent/100) : (1 - percent/100);
    await db.rawUpdate('UPDATE items SET sell_price = sell_price * ?, buy_price = buy_price * ?', [f, f]);
  }
}
