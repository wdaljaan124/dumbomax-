name: Build Flutter APK & AAB

on:
  push:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Print Flutter/Dart versions
        run: |
          flutter --version
          dart --version

      - name: Find Flutter project directory
        id: find_project
        shell: bash
        run: |
          PROJECT_DIR=""
          FALLBACK_DIR=""

          while IFS= read -r -d '' f; do
            dir=$(dirname "$f")
            if [ -f "$dir/android/app/build.gradle" ] || [ -f "$dir/android/app/build.gradle.kts" ]; then
              PROJECT_DIR="$dir"
              break
            fi
            if [ -z "$FALLBACK_DIR" ]; then
              FALLBACK_DIR="$dir"
            fi
          done < <(find . -name pubspec.yaml -not -path '*/.dart_tool/*' -not -path '*/build/*' -print0)

          if [ -z "$PROJECT_DIR" ]; then
            PROJECT_DIR="$FALLBACK_DIR"
          fi

          if [ -z "$PROJECT_DIR" ]; then
            echo "خطأ: لم يتم العثور على ملف pubspec.yaml — لا يبدو أنه مشروع Flutter؟"
            exit 1
          fi

          echo "تم العثور على مشروع Flutter في: $PROJECT_DIR"
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
          echo "project_dir=$PROJECT_DIR" >> "$GITHUB_OUTPUT"

      - name: Debug - list project contents
        if: always()
        run: |
          echo "PROJECT_DIR=$PROJECT_DIR"
          ls -la "$PROJECT_DIR"
          echo "--- فحص وحدة android ---"
          if [ -f "$PROJECT_DIR/android/app/build.gradle" ] || [ -f "$PROJECT_DIR/android/app/build.gradle.kts" ]; then
            echo "موجود: android/app/build.gradle(.kts)"
          else
            echo "مفقود: android/app/build.gradle (سيتم توليده مؤقتاً على العداء)"
          fi

      - name: Install dependencies (initial)
        run: flutter pub get
        working-directory: ${{ env.PROJECT_DIR }}

      - name: Ensure Android platform exists (runner-only)
        run: |
          if [ ! -f "$PROJECT_DIR/android/app/build.gradle" ] && [ ! -f "$PROJECT_DIR/android/app/build.gradle.kts" ]; then
            echo "وحدة android غير موجودة — يتم توليد منصة android في مساحة عمل العداء"
            flutter create --platforms=android "$PROJECT_DIR"
            cd "$PROJECT_DIR"
            flutter pub get
          else
            echo "وحدة android موجودة بالفعل — تخطي التوليد"
          fi
        working-directory: ${{ env.PROJECT_DIR }}

      - name: Build APK (debug)
        run: flutter build apk --debug
        working-directory: ${{ env.PROJECT_DIR }}

      - name: Prepare release keystore
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          if [ -z "$KEYSTORE_BASE64" ]; then
            echo "خطأ: السر KEYSTORE_BASE64 غير مُعرّف. أضف الأسرار الأربعة أولاً."
            exit 1
          fi

          KEYSTORE_PATH="$RUNNER_TEMP/upload-keystore.jks"
          echo "$KEYSTORE_BASE64" | base64 -d > "$KEYSTORE_PATH"

          cat > "$PROJECT_DIR/android/key.properties" <<EOF
          storePassword=${KEYSTORE_PASSWORD}
          keyPassword=${KEY_PASSWORD}
          keyAlias=${KEY_ALIAS}
          storeFile=${KEYSTORE_PATH}
          EOF

          echo "KEYSTORE_PATH=$KEYSTORE_PATH" >> "$GITHUB_ENV"
          echo "تم تجهيز keystore و key.properties"

      - name: Configure Android signing (inject if missing)
        run: |
          GRADLE_FILE="$PROJECT_DIR/android/app/build.gradle"
          if [ ! -f "$GRADLE_FILE" ]; then
            GRADLE_FILE="$PROJECT_DIR/android/app/build.gradle.kts"
          fi

          if [ -f "$GRADLE_FILE" ] && ! grep -q "key.properties" "$GRADLE_FILE"; then
            echo "إضافة إعدادات التوقيع إلى $GRADLE_FILE"

            if [[ "$GRADLE_FILE" == *.kts ]]; then
              # Gradle Kotlin DSL
              python3 - "$GRADLE_FILE" <<'PY'
import sys, re
p = sys.argv[1]
s = open(p).read()

signing_block = '''
import java.util.Properties
import java.io.FileInputStream

val keystoreProperties = Properties()
val keystorePropertiesFile = rootProject.file("key.properties")
if (keystorePropertiesFile.exists()) {
    keystoreProperties.load(FileInputStream(keystorePropertiesFile))
}
'''

if "keystoreProperties" not in s:
    s = signing_block + "\n" + s

if "signingConfigs" not in s:
    s = re.sub(
        r"android\s*\{",
        """android {
    signingConfigs {
        create("release") {
            keyAlias = keystoreProperties["keyAlias"] as String?
            keyPassword = keystoreProperties["keyPassword"] as String?
            storeFile = keystoreProperties["storeFile"]?.let { file(it) }
            storePassword = keystoreProperties["storePassword"] as String?
        }
    }
""",
        s, count=1
    )

s = s.replace(
    "buildTypes {\n        getByName(\"release\") {",
    "buildTypes {\n        getByName(\"release\") {\n            signingConfig = signingConfigs.getByName(\"release\")"
)
open(p, "w").write(s)
PY
            else
              # Gradle Groovy DSL
              python3 - "$GRADLE_FILE" <<'PY'
import sys, re
p = sys.argv[1]
s = open(p).read()

signing_block = '''
def keystoreProperties = new Properties()
def keystorePropertiesFile = rootProject.file('key.properties')
if (keystorePropertiesFile.exists()) {
    keystoreProperties.load(new FileInputStream(keystorePropertiesFile))
}
'''

if "keystoreProperties" not in s:
    s = signing_block + "\n" + s

if "signingConfigs" not in s:
    s = re.sub(
        r"android\s*\{",
        """android {
    signingConfigs {
        release {
            keyAlias keystoreProperties['keyAlias']
            keyPassword keystoreProperties['keyPassword']
            storeFile keystoreProperties['storeFile'] ? file(keystoreProperties['storeFile']) : null
            storePassword keystoreProperties['storePassword']
        }
    }
""",
        s, count=1
    )

s = s.replace(
    "buildTypes {\n        release {",
    "buildTypes {\n        release {\n            signingConfig signingConfigs.release"
)
open(p, "w").write(s)
PY
            fi
          else
            echo "إعدادات التوقيع موجودة مسبقاً — تخطي الحقن"
          fi

      - name: Build AAB (release, signed)
        run: flutter build appbundle --release
        working-directory: ${{ env.PROJECT_DIR }}

      - name: Prepare artifacts
        run: |
          APK_SRC="$PROJECT_DIR/build/app/outputs/flutter-apk/app-debug.apk"
          AAB_SRC="$PROJECT_DIR/build/app/outputs/bundle/release/app-release.aab"

          if [ ! -f "$APK_SRC" ]; then
            echo "خطأ: لم يتم العثور على APK في $APK_SRC"
            ls -R "$PROJECT_DIR/build" || true
            exit 1
          fi

          if [ ! -f "$AAB_SRC" ]; then
            echo "خطأ: لم يتم العثور على AAB في $AAB_SRC"
            ls -R "$PROJECT_DIR/build" || true
            exit 1
          fi

          cp "$APK_SRC" "${GITHUB_WORKSPACE}/DumboMax.apk"
          cp "$AAB_SRC" "${GITHUB_WORKSPACE}/DumboMax.aab"
          echo "تم نسخ APK و AAB إلى مساحة العمل"

      - name: Cleanup keystore
        if: always()
        run: |
          rm -f "$RUNNER_TEMP/upload-keystore.jks" || true
          rm -f "$PROJECT_DIR/android/key.properties" || true
          echo "تم حذف keystore و key.properties من العداء"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: DumboMax-APK
          path: DumboMax.apk
          if-no-files-found: error

      - name: Upload AAB
        uses: actions/upload-artifact@v4
        with:
          name: DumboMax-AAB
          path: DumboMax.aab
          if-no-files-found: error
